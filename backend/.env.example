# FitMentor AI Backend Environment Configuration Template

PORT=5000
NODE_ENV=production

# Database Credentials
# For cloud databases (Neon, Supabase, Render, Railway, AWS RDS, etc.):
DATABASE_URL=postgresql://fitmentor_admin:your_secure_password@localhost:5432/fitmentor_db
DB_SSL=false

# Fallback Database Parameters (used when DATABASE_URL is not provided)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitmentor_db
DB_USER=fitmentor_admin
DB_PASSWORD=your_secure_password

# JWT Authentication Secrets
JWT_SECRET=fitmentor_super_secret_jwt_key_2026_change_in_prod
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated or '*' for all)
CORS_ORIGIN=*

# AI Provider Keys
GEMINI_API_KEY=your_google_gemini_api_key_here
