# FitMentor AI — Production & Local Environment Configuration
# Copy this file to .env or backend/.env and update values for your environment.

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=production

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# If using a cloud database (Neon, Supabase, Render, Railway, AWS RDS, etc.):
DATABASE_URL=postgresql://username:password@host:5432/fitmentor_db?sslmode=require
DB_SSL=true

# Or use individual connection parameters if DATABASE_URL is not provided:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitmentor_db
DB_USER=fitmentor_admin
DB_PASSWORD=your_secure_password

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# Provide a strong 64+ char random string in production
JWT_SECRET=fitmentor_super_secret_jwt_key_2026_change_in_prod
JWT_EXPIRES_IN=7d

# CORS Allowed Origins: Comma-separated list or '*'
# Example for split frontend/backend: https://fitmentor.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# ==============================================================================
# FRONTEND CONFIGURATION (Vite)
# ==============================================================================
# Unified deployment (Express serves React SPA): leave as /api or empty
# Split deployment (e.g. Vercel frontend + Render backend): https://api.yourdomain.com/api
VITE_API_BASE_URL=/api
VITE_APP_TITLE=FitMentor AI — Solo Leveling Fitness RPG

# ==============================================================================
# AI & INTEGRATIONS (Optional)
# ==============================================================================
GEMINI_API_KEY=your_google_gemini_api_key_here

